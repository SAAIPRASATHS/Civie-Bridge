# ---------------------------------------------------------------------------
# CivicBridge AI - local development configuration
# Copy to `.env` and adjust. Never commit a real `.env`.
# ---------------------------------------------------------------------------

# Application
APP_NAME=CivicBridge AI
ENVIRONMENT=development
DEBUG=true
API_HOST=127.0.0.1
API_PORT=8000
SUPPORT_LANGUAGES=en,ta

# PostgreSQL (created by backend/scripts/init_db.sql)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=civicbridge_app
POSTGRES_PASSWORD=civicbridge_dev_password
POSTGRES_DB=civicbridge
# Optional full override, takes precedence over the parts above:
# DATABASE_URL=postgresql+psycopg2://civicbridge_app:civicbridge_dev_password@localhost:5432/civicbridge

# Ollama (local LLM runtime). Swap OLLAMA_MODEL without touching code.
OLLAMA_BASE_URL=http://localhost:11434
# Project-aligned alias for the local model. Create it once with:
#   ollama cp <your-model>:latest civicbridge-ai:latest
# Aliasing/renaming never retrains a model or changes its capabilities.
OLLAMA_MODEL=civicbridge-ai:latest
OLLAMA_HEALTH_TIMEOUT=5
# Layers offloaded to the GPU. Left unset so Ollama decides (recommended - uses
# the GPU when one is available); set 0 to force CPU-only inference.
# OLLAMA_NUM_GPU=0
# Generous ceiling: an 8B model can take minutes for a long answer.
OLLAMA_LLM_TIMEOUT=600
OLLAMA_TEMPERATURE=0
OLLAMA_NUM_PREDICT=256
OLLAMA_KEEP_ALIVE=5m

# Agents (Phase 3). The pipeline makes at most two model calls per complaint and
# falls back to deterministic Python extraction when the model is unavailable.
AGENT_USE_LLM=true
# Below this confidence the classification agent flags the complaint for a human.
AGENT_CONFIDENCE_THRESHOLD=0.60
# Extra attempts to obtain schema-valid JSON after the first model response.
AGENT_MAX_REPAIR_ATTEMPTS=1
# Token budget for agent structured output (larger than the smoke-test budget).
AGENT_NUM_PREDICT=512
# Bounded in-process cache of identical prompts; avoids duplicate inference.
AGENT_RESPONSE_CACHE_SIZE=256

# Orchestration (Phase 6). Bounds for the LangGraph workflow; the agents degrade
# internally, so these only fire when a call genuinely hangs.
ORCHESTRATION_ENABLED=true
# Wall-clock ceiling for one graph node before it is failed and degrades.
ORCHESTRATION_NODE_TIMEOUT_SECONDS=240
# Total attempts (first try + retries) for one node; transient errors only.
ORCHESTRATION_MAX_NODE_ATTEMPTS=2
# Upper bound on the whole run, checked between nodes.
ORCHESTRATION_TOTAL_TIMEOUT_SECONDS=900
# In-process checkpointer; enables resume of a human-review interrupt.
ORCHESTRATION_CHECKPOINTING_ENABLED=true
# Default for whether the human-review checkpoint pauses; opt in per request.
ORCHESTRATION_INTERRUPT_FOR_REVIEW=false

# Authentication and authorisation (Phase 7). The server resolves the caller from
# a signed HttpOnly cookie on every request; the browser is never trusted.
AUTH_ENABLED=true
# HMAC key for the signed session cookie. DEVELOPMENT DEFAULT - replace with a
# long random value before any non-prototype deployment.
SESSION_SECRET_KEY=civicbridge-prototype-session-key-change-me
SESSION_COOKIE_NAME=civicbridge_session
# Session lifetime in seconds (8 hours).
SESSION_TTL_SECONDS=28800
# Send the cookie only over HTTPS; left off for local http:// development.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
# Known demo passwords for the synthetic accounts (see /api/auth/demo-accounts).
# Not secrets - change before any real use.
AUTH_CITIZEN_PASSWORD=citizen-demo-password
AUTH_OFFICER_PASSWORD=officer-demo-password
AUTH_ADMIN_PASSWORD=admin-demo-password

# Uploads (Phase 7). Enforced before any bytes reach the evidence agent.
MAX_UPLOAD_BYTES=8388608
ALLOWED_UPLOAD_TYPES=image/jpeg,image/png,image/webp
# Explicit browser origins allowed to send credentialed requests - never "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
